# Application Environment
ENVIRONMENT=development
DEBUG=True

# Security
# In production, set a secure randomly generated string (min 32 characters, e.g. openssl rand -hex 32)
SECRET_KEY=supersecretjwtkey_change_in_production_min_32_characters_long!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL for Docker & Production, SQLite supported for quick local testing)
DATABASE_URL=postgresql://dealer_admin:dealer_secure_pass@localhost:5432/dealership_db
# For local development with SQLite, uncomment the line below:
# DATABASE_URL=sqlite:///./dealership.db

# Development-Only Admin User Seed Settings (Automatically skipped when ENVIRONMENT=production)
INITIAL_ADMIN_EMAIL=admin@apexmotors.com
INITIAL_ADMIN_PASSWORD=AdminSecurePass2026!
INITIAL_ADMIN_NAME=Apex Dealership Admin

# Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
